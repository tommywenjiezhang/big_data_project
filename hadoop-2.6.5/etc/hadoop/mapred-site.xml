<?xml version="1.0"?>
<configuration>

  <!-- Run MapReduce on YARN -->
  <property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
  </property>

  <!-- Default number of reducers (override per-job if needed) -->
  <property>
    <name>mapreduce.job.reduces</name>
    <value>2</value>
  </property>

  <!-- ========================= -->
  <!--   MAP TASK CONTAINERS     -->
  <!-- ========================= -->
  <!-- Map container memory: 1.5 GB -->
  <property>
    <name>mapreduce.map.memory.mb</name>
    <value>2048</value>
  </property>

  <!-- JVM heap inside map containers (~75–80% of container) -->
  <property>
    <name>mapreduce.map.java.opts</name>
    <value>-Xmx1638m</value>
  </property>

  <!-- ========================= -->
  <!--  REDUCE TASK CONTAINERS   -->
  <!-- ========================= -->
  <!-- Reduce container memory: 3 GB (more room for shuffle) -->
  <property>
    <name>mapreduce.reduce.memory.mb</name>
    <value>4096</value>
  </property>

  <!-- JVM heap inside reduce containers (~75% of container) -->
  <property>
    <name>mapreduce.reduce.java.opts</name>
    <value>-Xmx3278m</value>
  </property>

  
  <!-- ========================= -->
  <!--   OUTPUT / COMPRESSION    -->
  <!-- ========================= -->

  <!-- FileOutputCommitter v2 (faster) -->
  <property>
    <name>mapreduce.fileoutputcommitter.algorithm.version</name>
    <value>2</value>
  </property>

  <!-- Enable map output compression to reduce shuffle size -->
  <property>
    <name>mapreduce.map.output.compress</name>
    <value>true</value>
  </property>

  <property>
    <name>mapreduce.map.output.compress.codec</name>
    <value>org.apache.hadoop.io.compress.SnappyCodec</value>
  </property>

  <!-- ========================= -->
  <!--      SHUFFLE TUNING       -->
  <!-- ========================= -->

  
</configuration>
